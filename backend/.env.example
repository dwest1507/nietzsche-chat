GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
ALLOWED_ORIGINS=http://localhost:3000
# Required. Shared with the Next.js route handler (set the same value in
# Vercel) so only our frontend can call the public backend URL.
BACKEND_SHARED_SECRET=your_shared_secret_here

# Optional. Sentry DSN for backend error reporting. Intentionally left unset
# locally and in CI: with no DSN nothing is initialised and nothing is sent, so
# development failures — which are already in front of you in the terminal —
# never spend the free tier's monthly event budget. Set it in Railway, where a
# failure otherwise reaches nobody: the visitor closes the tab, and the
# container that logged the traceback has already scaled to zero.
# SENTRY_DSN=
