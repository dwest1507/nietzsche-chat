# Base URL of the FastAPI backend. Server-side only — the browser never calls
# the backend directly, it goes through the route handlers in app/api/.
CHAT_API_URL=http://localhost:8000

# Required. Sent as the X-Backend-Secret header on every backend call; must
# match BACKEND_SHARED_SECRET in the backend's environment or every chat
# request fails. Server-side only — never give it a NEXT_PUBLIC_ prefix.
BACKEND_SHARED_SECRET=your_shared_secret_here
